<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- Scrollable Main Content Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <!-- Top App Bar / Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Wakey"
                    android:textColor="@color/text_main"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black" />

                <ImageView
                    android:id="@+id/btnQuickSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_card_white"
                    android:padding="8dp"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/text_main"
                    android:contentDescription="Settings" />
            </RelativeLayout>

            <!-- ================= TAB 1: HOME / DASHBOARD ================= -->
            <LinearLayout
                android:id="@+id/viewHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Streak Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_flame"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Streak Flame"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAK"
                            android:textColor="@color/brand_orange"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStreakDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 Days"
                        android:textColor="@color/text_main"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginBottom="12dp"/>

                    <!-- Week Day Circles -->
                    <LinearLayout
                        android:id="@+id/weekDaysRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal"
                        android:weightSum="7">

                        <!-- Mon -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mon"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_flame"
                                android:layout_marginTop="4dp"
                                android:contentDescription="Day Streak"/>
                        </LinearLayout>

                        <!-- Tue -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tue"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_flame"
                                android:layout_marginTop="4dp"
                                android:contentDescription="Day Streak"/>
                        </LinearLayout>

                        <!-- Wed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wed"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_flame"
                                android:layout_marginTop="4dp"
                                android:contentDescription="Day Streak"/>
                        </LinearLayout>

                        <!-- Thu -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thu"
                                android:textColor="@color/brand_orange"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_flame"
                                android:layout_marginTop="4dp"
                                android:contentDescription="Day Streak"/>
                        </LinearLayout>

                        <!-- Fri -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fri"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_day_chip_inactive"
                                android:text="17"
                                android:gravity="center"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>

                        <!-- Sat -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sat"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_day_chip_inactive"
                                android:text="18"
                                android:gravity="center"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>

                        <!-- Sun -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sun"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                            <TextView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:background="@drawable/bg_day_chip_inactive"
                                android:text="19"
                                android:gravity="center"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"
                                android:layout_marginTop="5dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- HERO NEXT ALARM CARD (Reference Design) -->
                <LinearLayout
                    android:id="@+id/cardHeroNextAlarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:orientation="vertical"
                    android:padding="26dp"
                    android:layout_marginBottom="24dp">

                    <!-- Top Row: Next Alarm Label & Edit Button -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="NEXT ALARM"
                            android:textColor="#D4C4B7"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <ImageView
                            android:id="@+id/btnEditHeroAlarm"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:background="#2E1B11"
                            android:padding="7dp"
                            android:src="@drawable/ic_edit"
                            android:contentDescription="Edit Alarm" />
                    </RelativeLayout>

                    <!-- Center Alarm Label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_alarm_bell"
                            app:tint="#FFA040"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Bell Icon"/>

                        <TextView
                            android:id="@+id/tvHeroAlarmLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Morning Routine"
                            android:textColor="#FFA040"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Huge Bold Time -->
                    <TextView
                        android:id="@+id/tvHeroAlarmTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="06:30"
                        android:textColor="@color/text_hero_main"
                        android:textSize="54sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.02" />

                    <!-- Date Subtitle -->
                    <TextView
                        android:id="@+id/tvHeroAlarmDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="TOMORROW, FRIDAY 17 JULY"
                        android:textColor="@color/text_hero_sub"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="28dp" />

                    <!-- Bottom Two Columns: Mission & Sound -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:background="#24160E"
                        android:paddingVertical="14dp"
                        android:paddingHorizontal="16dp">

                        <!-- Mission Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_laptop"
                                    app:tint="@color/text_hero_main"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="Laptop verification"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="PC Verify"
                                    android:textColor="@color/text_hero_main"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disarm Mission"
                                android:textColor="#B09A8B"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="#4A2F1A" />

                        <!-- Sound Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_volume_up"
                                    app:tint="@color/text_hero_main"
                                    android:layout_marginEnd="6dp"
                                    android:contentDescription="Sound ringtone"/>

                                <TextView
                                    android:id="@+id/tvHeroSoundName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Heavy Alarm"
                                    android:textColor="@color/text_hero_main"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ringtone"
                                android:textColor="#B09A8B"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ================= TAB 2: ALARMS LIST ================= -->
            <LinearLayout
                android:id="@+id/viewAlarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Alarms"
                        android:textColor="@color/text_main"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvActiveAlarmsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="2 Active"
                        android:textColor="@color/brand_orange"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- RecyclerView for Alarms -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_alarm" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tvEmptyAlarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No alarms scheduled. Tap '+' below to create one!"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ================= TAB 3: PC SYNC & DEVELOPER SETTINGS ================= -->
            <LinearLayout
                android:id="@+id/viewSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PC Desktop Sync"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your device link to disarm alarms from your computer."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Laptop Web Access Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_laptop"
                            app:tint="@color/brand_orange"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Laptop icon"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DESKTOP DISARM URL"
                            android:textColor="@color/brand_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Open this URL in your PC browser when the alarm rings to silence it:"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="http://localhost:3000"
                        android:textColor="@color/accent_blue"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:background="#F0F9FF"
                        android:padding="12dp" />
                </LinearLayout>

                <!-- FCM Device Token Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_content_copy"
                            app:tint="@color/brand_orange"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Copy icon"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEVICE REGISTRATION TOKEN"
                            android:textColor="@color/brand_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFcmToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fetching token..."
                        android:textColor="@color/text_main"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:background="#F8FAFC"
                        android:padding="10dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textIsSelectable="true"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Copy Token for PC"
                        app:backgroundTint="@color/brand_orange"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_content_copy"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Instant Test & System Check Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/brand_orange"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Test icon"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TEST &amp; SYSTEM HEALTH"
                            android:textColor="@color/brand_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_shield_check"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Status check"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto-reschedules after phone reboot"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_shield_check"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Status check"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High priority Doze mode bypass active"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestAlarmNow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Test Trigger Alarm (Instant)"
                        app:backgroundTint="@color/accent_red"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_bolt"
                        app:iconTint="@color/white"
                        app:iconGravity="textStart"
                        app:cornerRadius="12dp"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check Background &amp; Exact Alarm Permissions"
                        app:backgroundTint="#ECEFF3"
                        android:textColor="@color/text_main"
                        app:cornerRadius="12dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar & Floating '+' Button -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <!-- Tab 1: Home / Main -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/brand_orange"
                android:contentDescription="Main Tab" />

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Main"
                android:textColor="@color/brand_orange"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 2: Alarms -->
        <LinearLayout
            android:id="@+id/tabAlarms"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavAlarms"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_alarms"
                app:tint="@color/text_muted"
                android:contentDescription="Alarms Tab" />

            <TextView
                android:id="@+id/tvNavAlarms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alarms"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tab 3: PC Sync & Settings -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_settings"
                app:tint="@color/text_muted"
                android:contentDescription="PC Sync Tab" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Sync"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Floating '+' Add Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_plus"
            app:backgroundTint="@color/brand_orange"
            app:tint="@color/white"
            app:elevation="4dp"
            app:fabSize="normal"
            android:contentDescription="Add Alarm" />

    </LinearLayout>

</RelativeLayout>
