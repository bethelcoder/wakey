<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0507"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top Alert Banner with Vector Icon -->
    <LinearLayout
        android:id="@+id/llTopBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="32dp"
        android:background="#260D12"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_warning"
            app:tint="#FF4D6D"
            android:layout_marginEnd="6dp"
            android:contentDescription="Warning icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE EMERGENCY ALARM"
            android:textColor="#FF4D6D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Center Alarm Hero Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivAlarmIcon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_alarm_bell"
            android:contentDescription="Alarm Icon"
            android:layout_marginBottom="16dp"/>

        <TextClock
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm:ss a"
            android:format24Hour="HH:mm:ss"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAlarmOverlayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MORNING ROUTINE"
            android:textColor="#FFA040"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKE UP!"
            android:textColor="#FF2A55"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG INTO LAPTOP BROWSER TO CLOSE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile dismiss is permanently disabled. You must get out of bed and authenticate on your PC."
            android:textColor="#A0A0B0"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="24dp" />
    </LinearLayout>

    <!-- Bottom Instruction Bar with Vector Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_lock"
            app:tint="#71718A"
            android:layout_marginEnd="6dp"
            android:contentDescription="Lock icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen locked until PC signal arrives"
            android:textColor="#71718A"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</RelativeLayout>
