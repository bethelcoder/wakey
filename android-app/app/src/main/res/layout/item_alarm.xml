<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAlarmRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Row: Label & Toggle Switch -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Morning Routine"
            android:textColor="@color/brand_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:thumbTint="@color/white"
            app:trackTint="@color/accent_green" />
    </RelativeLayout>

    <!-- Middle Row: Large Time & AM/PM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAlarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6:30"
            android:textColor="@color/text_main"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tvAlarmAmPm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:text="am"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle: Vector Icon Mission & Sound Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_laptop"
            app:tint="@color/text_muted"
            android:layout_marginEnd="5dp"
            android:contentDescription="PC Verification"/>

        <TextView
            android:id="@+id/tvAlarmDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC Desktop Login • Heavy Alarm"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Row: Day Chips (M, T, W, T, F, S, S) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipMon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/day_chip_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipTue"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/day_chip_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipWed"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="W"
            android:textColor="@color/day_chip_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipThu"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/day_chip_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipFri"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="F"
            android:textColor="@color/day_chip_active_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipSat"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_day_chip_inactive"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/day_chip_inactive_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipSun"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_day_chip_inactive"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/day_chip_inactive_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
