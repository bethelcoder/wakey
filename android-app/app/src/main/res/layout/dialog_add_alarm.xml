<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Alarm"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Time Picker -->
    <TimePicker
        android:id="@+id/dialogTimePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:timePickerMode="spinner"
        android:layout_marginBottom="16dp" />

    <!-- Label Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alarm Label"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/brand_orange"
        app:hintTextColor="@color/brand_orange"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAlarmLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Morning Routine"
            android:textColor="@color/text_main"
            android:maxLines="1"
            android:inputType="textCapWords" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Repeat Days Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REPEAT DAYS"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnDayMon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="M"
            android:textColor="@color/day_chip_active_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDayTue"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/day_chip_active_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDayWed"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="W"
            android:textColor="@color/day_chip_active_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDayThu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/day_chip_active_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDayFri"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_active"
            android:gravity="center"
            android:text="F"
            android:textColor="@color/day_chip_active_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDaySat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_inactive"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/day_chip_inactive_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDaySun"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_day_chip_inactive"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/day_chip_inactive_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Preset Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/btnPresetWeekdays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekdays"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="@color/text_muted"/>

        <TextView
            android:id="@+id/btnPresetWeekends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekends"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="@color/text_muted"/>

        <TextView
            android:id="@+id/btnPresetEveryday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Everyday"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- Mission Notice with Vector Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8F0"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_laptop"
            app:tint="@color/brand_orange"
            android:layout_marginEnd="10dp"
            android:contentDescription="PC Mission Icon"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mission: Requires physical PC Desktop verification to disarm."
            android:textColor="#92400E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Delete"
            android:visibility="gone"
            app:backgroundTint="#FEE2E2"
            android:textColor="@color/accent_red"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            app:backgroundTint="#ECEFF3"
            android:textColor="@color/text_main"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Save Alarm"
            app:backgroundTint="@color/brand_orange"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
